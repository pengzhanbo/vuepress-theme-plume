// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`pdfPlugin > should fallback to page 1 when page is invalid 1`] = `"<VPPdf src="foo.pdf" :page="1" width="100%" />"`;

exports[`pdfPlugin > should not work 1`] = `
"<VPPdf src="" :page="1" width="100%" /><p>@[pdf]xxx</p>
<p>@<a href=""> pdf</a></p>
<p>@[pdf]</p>
"
`;

exports[`pdfPlugin > should work 1`] = `"<VPPdf src="foo.pdf" :page="1" width="100%" />"`;

exports[`pdfPlugin > should work 2`] = `"<VPPdf src="foo.pdf" :page="1" width="100%" /><VPPdf src="foo.pdf" :page="2" width="100%" /><VPPdf src="foo.pdf" :page="2" width="100%" /><VPPdf src="foo.pdf" :page="3" width="100%" height="600px" ratio="1:1" /><VPPdf src="foo.pdf" :page="1" width="100%" height="600px" ratio="1:1" /><VPPdf src="foo.pdf" :page="1" width="100%" />"`;
